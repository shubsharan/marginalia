{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "ignorePatterns": [
    ".agents/**",
    ".specify/**",
    "**/.next/**",
    "**/out/**",
    "**/build/**",
    "**/dist/**",
    "**/.turbo/**",
    "**/coverage/**",
    "**/next-env.d.ts"
  ],
  "overrides": [
    {
      "files": ["**/*.md", "**/*.mdx"],
      "options": {
        "proseWrap": "always"
      }
    }
  ]
}
