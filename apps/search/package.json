{
  "name": "search",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --env-file=.env.local --watch run src/server.ts",
    "start": "bun --env-file=.env.local run src/server.ts",
    "db:migrate": "bun --env-file=.env.local run src/db.ts --migrate",
    "test": "bun --no-env-file test --path-ignore-patterns '**/live-acceptance.test.ts' ./tests",
    "test:live": "bun --env-file=.env.local test ./tests/live-acceptance.test.ts",
    "check-types": "tsc --noEmit"
  },
  "devDependencies": {
    "@repo/typescript-config": "*",
    "@types/bun": "^1.4.3",
    "typescript": "7.0.2"
  }
}
